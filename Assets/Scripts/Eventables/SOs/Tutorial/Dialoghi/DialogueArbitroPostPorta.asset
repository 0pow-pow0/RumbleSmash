  state: 4
  speakerName: Allenatore
  speakerIcon: {fileID: 21300000, guid: d8089a233f050bd44bc53e803904a7cb, type: 3}
  <MAX_CHAR_COUNTER>k__BackingField: 160
  sentences:
  - content: Basta cosi'.
    framesBetweenChars: 8
  - content: Ho visto abbastanza, sarebbe stato un peccato se ti fossi realmente
      ritirato.
    framesBetweenChars: 1
  - content: Hai un talento ragazzo, non puoi sprecarlo in questo modo!
    framesBetweenChars: 1
  - content: Per oggi ti sei allenato abbastanza, riposati.
    framesBetweenChars: 1
  - content: A breve potresti ricevere richieste di sfida da avversari temibili,
      buona fortuna...
    framesBetweenChars: 1
  dialoguePrefab: {fileID: 6382298188097560065, guid: 81ccea20632d5184db32a87520b52564, type: 3}
