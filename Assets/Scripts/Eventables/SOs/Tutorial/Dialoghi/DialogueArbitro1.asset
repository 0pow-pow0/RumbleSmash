  <MAX_CHAR_COUNTER>k__BackingField: 160
  sentences:
  - content: Ah, dunque non ti sei arreso...
    framesBetweenChars: 8
  - content: Beh, e' un bene, credi abbia senso arrendersi?
    framesBetweenChars: 1
  - content: Adesso alzati e sgranchisci quelle gambe. Un sogno non si costruisce
      dal nulla!
